<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zentra.server.mapper.CategoryMapper">

    <!-- ========================================= -->
    <!-- Result Mapping -->
    <!-- ========================================= -->
    <resultMap id="CategoryResultMap"
               type="com.zentra.server.entity.Category">

        <id property="id" column="id"/>

        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- ========================================= -->
    <!-- Insert category -->
    <!-- ========================================= -->
    <insert id="insert"
            parameterType="com.zentra.server.entity.Category"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO category (
            name,
            type,
            status,
            sort,
            merchant_id
        )
        VALUES (
                   #{name},
                   #{type},
                   #{status},
                   #{sort},
                   #{merchantId}
               )

    </insert>

    <!-- ========================================= -->
    <!-- Query categories with pagination -->
    <!-- ========================================= -->
    <select id="findPage"
            resultMap="CategoryResultMap">

        SELECT
            id,
            name,
            type,
            status,
            sort,
            merchant_id,
            created_at,
            updated_at
        FROM category
        WHERE merchant_id = #{merchantId}

        <!-- Optional type filter -->
        <if test="type != null">
            AND type = #{type}
        </if>

        <!-- Optional status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

        ORDER BY sort ASC, id DESC

        LIMIT #{offset}, #{pageSize}

    </select>

    <!-- ========================================= -->
    <!-- Count total categories -->
    <!-- ========================================= -->
    <select id="count"
            resultType="java.lang.Long">

        SELECT COUNT(*)
        FROM category
        WHERE merchant_id = #{merchantId}

        <!-- Optional type filter -->
        <if test="type != null">
            AND type = #{type}
        </if>

        <!-- Optional status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

    </select>

    <!-- ========================================= -->
    <!-- Find category by id -->
    <!-- ========================================= -->
    <select id="findById"
            resultMap="CategoryResultMap">

        SELECT
            id,
            name,
            type,
            status,
            sort,
            merchant_id,
            created_at,
            updated_at
        FROM category
        WHERE id = #{id}
          AND merchant_id = #{merchantId}

    </select>

    <!-- ========================================= -->
    <!-- Update category -->
    <!-- ========================================= -->
    <update id="update"
            parameterType="com.zentra.server.entity.Category">

        UPDATE category

        <set>

            <!-- Update category name -->
            <if test="name != null">
                name = #{name},
            </if>

            <!-- Update category type -->
            <if test="type != null">
                type = #{type},
            </if>

            <!-- Update category status -->
            <if test="status != null">
                status = #{status},
            </if>

            <!-- Update category sort -->
            <if test="sort != null">
                sort = #{sort},
            </if>

            <!-- Auto update timestamp -->
            updated_at = NOW()

        </set>

        WHERE id = #{id}
        AND merchant_id = #{merchantId}

    </update>

    <!-- ========================================= -->
    <!-- Delete category by id -->
    <!-- ========================================= -->
    <delete id="deleteById">

        DELETE FROM category
        WHERE id = #{id}
          AND merchant_id = #{merchantId}

    </delete>

</mapper>