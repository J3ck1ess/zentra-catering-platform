<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zentra.server.mapper.OrderMapper">

    <!-- ========================================= -->
    <!-- Result Mapping -->
    <!-- ========================================= -->
    <resultMap id="OrderResultMap"
               type="com.zentra.server.entity.Order">

        <id property="id" column="id"/>

        <result property="merchantId" column="merchant_id"/>
        <result property="userId" column="user_id"/>
        <result property="orderNumber" column="order_number"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- ========================================= -->
    <!-- Insert order -->
    <!-- ========================================= -->
    <insert id="insert"
            parameterType="com.zentra.server.entity.Order"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO orders (
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status
        )
        VALUES (
            #{merchantId},
            #{userId},
            #{orderNumber},
            #{totalAmount},
            #{status}
        )

    </insert>

    <!-- ========================================= -->
    <!-- Query order list with pagination -->
    <!-- ========================================= -->
    <select id="findPage"
            resultMap="OrderResultMap">

        SELECT
            id,
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status,
            created_at,
            updated_at
        FROM orders
        WHERE merchant_id = #{merchantId}

        <!-- Optional order status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

        ORDER BY created_at DESC, id DESC

        LIMIT #{offset}, #{pageSize}

    </select>

    <!-- ========================================= -->
    <!-- Count orders -->
    <!-- ========================================= -->
    <select id="count"
            resultType="java.lang.Long">

        SELECT COUNT(*)
        FROM orders
        WHERE merchant_id = #{merchantId}

        <!-- Optional order status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

    </select>

    <!-- ========================================= -->
    <!-- Query order by id -->
    <!-- ========================================= -->
    <select id="findById"
            resultMap="OrderResultMap">

        SELECT
            id,
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status,
            created_at,
            updated_at
        FROM orders
        WHERE id = #{id}
          AND merchant_id = #{merchantId}

    </select>

    <!-- ========================================= -->
    <!-- Query current user's order by id -->
    <!-- ========================================= -->
    <select id="findUserOrderById"
            resultMap="OrderResultMap">

        SELECT
            id,
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status,
            created_at,
            updated_at
        FROM orders
        WHERE id = #{id}
          AND user_id = #{userId}

    </select>

    <!-- ========================================= -->
    <!-- Query current user's orders -->
    <!-- ========================================= -->
    <select id="findUserOrders"
            resultMap="OrderResultMap">

        SELECT
            id,
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status,
            created_at,
            updated_at
        FROM orders
        WHERE user_id = #{userId}

        <!-- Optional order status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

        ORDER BY created_at DESC, id DESC

        LIMIT #{offset}, #{pageSize}

    </select>

    <!-- ========================================= -->
    <!-- Count current user's orders -->
    <!-- ========================================= -->
    <select id="countUserOrders"
            resultType="java.lang.Long">

        SELECT COUNT(*)
        FROM orders
        WHERE user_id = #{userId}

        <!-- Optional order status filter -->
        <if test="status != null">
            AND status = #{status}
        </if>

    </select>

    <!-- ========================================= -->
    <!-- Update order status -->
    <!-- ========================================= -->
    <update id="updateStatus">

        UPDATE orders

        <set>

            <!-- Update order status -->
            status = #{status},

            <!-- Auto update timestamp -->
            updated_at = NOW()

        </set>

        WHERE id = #{id}
        AND merchant_id = #{merchantId}

    </update>

    <!-- ========================================= -->
    <!-- Query expired pending orders -->
    <!-- ========================================= -->
    <select id="findExpiredPendingOrders"
            resultMap="OrderResultMap">

        SELECT
            id,
            merchant_id,
            user_id,
            order_number,
            total_amount,
            status,
            created_at,
            updated_at
        FROM orders
        WHERE status = #{status}
          AND created_at <![CDATA[ <= ]]> DATE_SUB(
                NOW(),
                INTERVAL 30 MINUTE
        )

    </select>

    <!-- ========================================= -->
    <!-- Update order status by id -->
    <!-- ========================================= -->
    <update id="updateStatusById">

        UPDATE orders

        <set>

            status = #{status},

            updated_at = NOW()

        </set>

        WHERE id = #{id}

    </update>

</mapper>