<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zentra.server.mapper.UserMapper">

    <!-- ========================================= -->
    <!-- Result Mapping -->
    <!-- ========================================= -->
    <resultMap id="UserResultMap"
               type="com.zentra.server.entity.User">

        <id property="id" column="id"/>

        <result property="merchantId" column="merchant_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- ========================================= -->
    <!-- Insert user -->
    <!-- ========================================= -->
    <insert id="insert"
            parameterType="com.zentra.server.entity.User"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO user (
            merchant_id,
            username,
            password,
            nickname,
            phone,
            status
        )
        VALUES (
                   #{merchantId},
                   #{username},
                   #{password},
                   #{nickname},
                   #{phone},
                   #{status}
               )

    </insert>

    <!-- ========================================= -->
    <!-- Find user by username -->
    <!-- ========================================= -->
    <select id="findByUsername"
            resultMap="UserResultMap">

        SELECT
            id,
            merchant_id,
            username,
            password,
            nickname,
            phone,
            status,
            created_at,
            updated_at
        FROM user
        WHERE username = #{username}
          AND merchant_id = #{merchantId}

    </select>

    <!-- ========================================= -->
    <!-- Find user by id -->
    <!-- ========================================= -->
    <select id="findById"
            resultMap="UserResultMap">

        SELECT
            id,
            merchant_id,
            username,
            password,
            nickname,
            phone,
            status,
            created_at,
            updated_at
        FROM user
        WHERE id = #{id}
          AND merchant_id = #{merchantId}

    </select>

    <!-- ========================================= -->
    <!-- Find user by username -->
    <!-- ========================================= -->
    <select id="findByUsernameOnly"
            resultMap="UserResultMap">

        SELECT
            id,
            merchant_id,
            username,
            password,
            status,
            created_at,
            updated_at
        FROM user
        WHERE username = #{username}

    </select>

    <!-- ========================================= -->
    <!-- Query user list with pagination -->
    <!-- ========================================= -->
    <select id="findPage"
            resultMap="UserResultMap">

        SELECT
            id,
            merchant_id,
            username,
            password,
            nickname,
            phone,
            status,
            created_at,
            updated_at
        FROM user

        <where>

            <!-- Optional fuzzy search by username -->
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>

            <!-- Optional status filter -->
            <if test="status != null">
                AND status = #{status}
            </if>

        </where>

        ORDER BY created_at DESC

        LIMIT #{offset}, #{pageSize}

    </select>

    <!-- ========================================= -->
    <!-- Count users -->
    <!-- ========================================= -->
    <select id="count"
            resultType="long">

        SELECT COUNT(*)
        FROM user

        <where>

            <!-- Optional fuzzy search by username -->
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>

            <!-- Optional status filter -->
            <if test="status != null">
                AND status = #{status}
            </if>

        </where>

    </select>

    <!-- ========================================= -->
    <!-- Query user by id for admin management -->
    <!-- ========================================= -->
    <select id="findByIdOnly"
            resultMap="UserResultMap">

        SELECT
            id,
            merchant_id,
            username,
            password,
            nickname,
            phone,
            status,
            created_at,
            updated_at
        FROM user
        WHERE id = #{id}

    </select>

    <!-- ========================================= -->
    <!-- Update user -->
    <!-- ========================================= -->
    <update id="update"
            parameterType="com.zentra.server.entity.User">

        UPDATE user

        <set>

            <!-- Update username -->
            <if test="username != null">
                username = #{username},
            </if>

            <!-- Update nickname -->
            <if test="nickname != null">
                nickname = #{nickname},
            </if>

            <!-- Update phone -->
            <if test="phone != null">
                phone = #{phone},
            </if>

            <!-- Update user status -->
            <if test="status != null">
                status = #{status},
            </if>

            <!-- Auto update timestamp -->
            updated_at = NOW()

        </set>

        WHERE id = #{id}

    </update>

</mapper>